{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1100px"
		},
		"color": {
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#fafaf7" },
				{ "slug": "contrast", "name": "Contrast", "color": "#1d1d1b" },
				{ "slug": "accent", "name": "Accent", "color": "#2f5d50" },
				{ "slug": "muted", "name": "Muted", "color": "#6b6b66" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "1.0625rem",
			"lineHeight": "1.65"
		},
		"spacing": {
			"padding": { "left": "1.25rem", "right": "1.25rem" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" }
			},
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "1.2" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
